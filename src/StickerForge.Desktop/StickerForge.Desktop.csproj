<Project Sdk="Microsoft.NET.Sdk">
<PropertyGroup><OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><ApplicationIcon>Assets/StickerForge.ico</ApplicationIcon><Version>1.0.0</Version></PropertyGroup>
<ItemGroup><PackageReference Include="Avalonia.Desktop" Version="12.1.6" /><PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" /></ItemGroup>
<ItemGroup><AvaloniaResource Include="Assets/StickerForge.ico" /><AvaloniaResource Include="Assets/StickerForge.png" /></ItemGroup>
<ItemGroup>
  <ProjectReference Include="../StickerForge.Core/StickerForge.Core.csproj" />
  <ProjectReference Include="../StickerForge.Infrastructure/StickerForge.Infrastructure.csproj" />
  <ProjectReference Include="../StickerForge.Media/StickerForge.Media.csproj" />
</ItemGroup>
<!-- A normal build must contain the same verified offline catalog as the ZIP. -->
<PropertyGroup>
  <FontPreparationShell Condition="'$(OS)' == 'Windows_NT'">powershell</FontPreparationShell>
  <FontPreparationShell Condition="'$(OS)' != 'Windows_NT'">pwsh</FontPreparationShell>
</PropertyGroup>
<Target Name="PrepareBundledFonts" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true' and !Exists('$(TargetDir)fonts/manifest.json')">
  <Exec Command="$(FontPreparationShell) -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\eng\prepare-fonts.ps1&quot; -OutputDirectory &quot;$(TargetDir)fonts&quot;" />
</Target>
<Target Name="PublishBundledFonts" AfterTargets="Publish" Condition="'$(DesignTimeBuild)' != 'true' and !Exists('$(PublishDir)fonts/manifest.json')">
  <Exec Command="$(FontPreparationShell) -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\..\eng\prepare-fonts.ps1&quot; -OutputDirectory &quot;$(PublishDir)fonts&quot;" />
</Target>
</Project>
